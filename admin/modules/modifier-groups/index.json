{
    "expandable": false,
    "headerActions": {
        "elements": [
            {
                "key": "reload",
                "ui": {
                    "type": "button",
                    "icon": "tabler-refresh",
                    "color": "success",
                    "rounded": true
                },
                "tooltip": "Refresh List",
                "action": "reload",
                "class": "ms-2"
            },
            {
                "key": "create",
                "ui": {
                    "type": "button",
                    "icon": "tabler-plus",
                    "color": "primary",
                    "rounded": "md"
                },
                "label": "New Group",
                "tooltip": "Click to add a new modifier group",
                "action": "navigate",
                "to": "/module/modifier-groups/create"
            }
        ]
    },
    "filters": {
        "elements": [
            {
                "ui": { "type": "field" },
                "key": "status",
                "label": "Status",
                "placeholder": "Select Status",
                "type": "select",
                "options": {
                    "url": "/admin/modules/modifier-groups/options",
                    "master": "status"
                }
            },
            {
                "ui": { "type": "field" },
                "key": "selection",
                "label": "Selection",
                "placeholder": "Single or multiple",
                "type": "select",
                "options": {
                    "items": [
                        { "title": "Single (radio)", "value": "single" },
                        { "title": "Multiple (checkbox)", "value": "multiple" }
                    ]
                }
            }
        ]
    },
    "elements": [
        {
            "ui": { "type": "display" },
            "label": "ID",
            "key": "id",
            "sortable": true,
            "width": "60px"
        },
        {
            "ui": { "type": "display" },
            "label": "Question",
            "key": "title",
            "sortable": true,
            "searchable": true
        },
        {
            "ui": { "type": "display" },
            "label": "Slug",
            "key": "slug",
            "sortable": true,
            "searchable": true
        },
        {
            "ui": { "type": "display" },
            "label": "Selection",
            "key": "selection",
            "sortable": true,
            "align": "center"
        },
        {
            "ui": { "type": "display" },
            "label": "Options",
            "key": "modifiers_count",
            "sortable": false,
            "align": "center"
        },
        {
            "ui": { "type": "display" },
            "label": "Dishes",
            "key": "dishes_count",
            "sortable": false,
            "align": "center"
        },
        {
            "ui": { "type": "display" },
            "label": "Status",
            "key": "status",
            "sortable": false,
            "align": "center",
            "type": "status"
        },
        {
            "ui": { "type": "display" },
            "label": "Created At",
            "key": "created_at",
            "sortable": true,
            "align": "center",
            "type": "datetime"
        }
    ],
    "actions": {
        "elements": [
            "view",
            "edit",
            {
                "key": "delete",
                "action": "delete",
                "ui": {
                    "type": "button",
                    "icon": "tabler-trash",
                    "color": "error",
                    "rounded": true
                },
                "params": {
                    "confirm": true,
                    "confirmText": "Delete this modifier group? Dishes using it will stop asking the question."
                }
            }
        ],
        "class": "fit"
    }
}
