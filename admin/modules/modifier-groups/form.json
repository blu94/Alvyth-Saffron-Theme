{
  "elements": [
    {
      "ui": {
        "type": "section",
        "cols": 12,
        "icon": "tabler-help-circle"
      },
      "name": "The Question",
      "subtitle": "A question your menu asks about a dish — \"Choose your side\", \"Sugar level\", \"Add extras\". Write it once here, then attach it to as many dishes as you like from each dish's Modifiers tab. Not the same as a variant: a variant is a separate version you stock and price (Regular vs Large), a modifier is a choice the customer makes about the dish they already picked.",
      "elements": [
        {
          "ui": { "type": "field", "cols": 12 },
          "key": "title",
          "type": "text",
          "label": "Question",
          "placeholder": "e.g. Choose your side",
          "hint": "Shown as the heading on the dish sheet, and printed on the kitchen ticket as the option label",
          "translatable": true,
          "rules": ["required", "max:120"]
        },
        {
          "ui": { "type": "field", "cols": 12 },
          "key": "description",
          "type": "textarea",
          "label": "Helper Text",
          "placeholder": "e.g. Fries, salad or rice — swap for onion rings at no charge",
          "translatable": true
        },
        {
          "ui": { "type": "field", "cols": 4 },
          "key": "selection",
          "type": "select",
          "label": "Selection",
          "hint": "Single renders radios, multiple renders checkboxes",
          "options": {
            "items": [
              { "title": "Single (radio)", "value": "single" },
              { "title": "Multiple (checkbox)", "value": "multiple" }
            ]
          },
          "default": "single",
          "rules": ["required"]
        },
        {
          "ui": { "type": "field", "cols": 4 },
          "key": "min_select",
          "type": "number",
          "label": "Minimum Answers",
          "placeholder": "e.g. 1",
          "hint": "1 makes the question compulsory. 0 lets the customer skip it",
          "default": 0,
          "rules": ["integer", "min:0"]
        },
        {
          "ui": { "type": "field", "cols": 4 },
          "key": "max_select",
          "type": "number",
          "label": "Maximum Answers",
          "placeholder": "Leave empty for unlimited",
          "hint": "Ignored when the selection is single, which always allows exactly one",
          "rules": ["integer", "min:1"]
        }
      ]
    },
    {
      "ui": {
        "type": "section",
        "cols": 12,
        "icon": "tabler-list-check"
      },
      "name": "The Answers",
      "subtitle": "One row per choice the customer can pick — fries, salad, rice. A group with no answers asks a question nobody can answer, and a group attached to no dish is never shown at all: attach it from the dish's Modifiers tab once you have saved it here.",
      "elements": [
        {
          "ui": { "type": "field", "cols": 12 },
          "key": "modifiers",
          "type": "repeater",
          "label": "Answers",
          "itemLabel": "Answer",
          "columns": [
            { "label": "Answer", "key": "title" },
            { "label": "Price", "key": "price_delta" },
            { "label": "Default", "key": "is_default" },
            { "label": "Status", "key": "status", "type": "status" }
          ],
          "dialog": {
            "width": 700,
            "create": {
              "title": "Add Answer",
              "subtitle": "Leave the price at 0.00 unless you have decided how paid add-ons are charged."
            },
            "update": { "title": "Edit Answer" }
          },
          "elements": [
            {
              "ui": { "type": "field", "cols": 12 },
              "key": "title",
              "type": "text",
              "label": "Answer",
              "placeholder": "e.g. Extra cheese",
              "translatable": true,
              "rules": ["required", "max:120"]
            },
            {
              "ui": { "type": "field", "cols": 6 },
              "key": "price_delta",
              "type": "number",
              "label": "Price Change",
              "placeholder": "0.00",
              "hint": "WARNING: nothing charges this yet. The cart is re-priced server-side from the dish and its variant, with no concept of a modifier surcharge, so a non-zero figure is shown to the customer and then not collected. Keep it at 0.00 until paid add-ons are decided.",
              "default": 0
            },
            {
              "ui": { "type": "field", "cols": 6 },
              "key": "is_default",
              "type": "switch",
              "label": "Pre-selected",
              "hint": "A single-selection group keeps only the first pre-selected answer",
              "default": false
            },
            {
              "ui": { "type": "field", "cols": 12 },
              "key": "product_id",
              "type": "autocomplete",
              "label": "Linked Dish (Optional)",
              "hint": "Only needed when this answer is itself a sellable product — the route paid add-ons will take",
              "options": {
                "url": "/admin/products",
                "master": "data",
                "map": { "title": "title.en", "value": "id" }
              }
            },
            {
              "ui": { "type": "field", "cols": 12 },
              "key": "status",
              "type": "select",
              "label": "Status",
              "options": {
                "items": [
                  { "title": "Active", "value": "active" },
                  { "title": "Draft", "value": "draft" }
                ]
              },
              "default": "active"
            }
          ]
        }
      ]
    }
  ],
  "sidebar": {
    "elements": [
      {
        "ui": { "type": "row", "dense": true },
        "elements": [
          {
            "ui": { "type": "field" },
            "key": "status",
            "type": "select",
            "label": "Status",
            "default": "active",
            "options": {
              "items": [
                { "title": "Active", "value": "active" },
                { "title": "Draft", "value": "draft" }
              ]
            }
          },
          {
            "ui": { "type": "field" },
            "key": "orders",
            "type": "number",
            "label": "Display Order",
            "placeholder": "e.g. 10",
            "hint": "Lower sorts first in the admin list"
          }
        ]
      }
    ],
    "footer": {
      "elements": [
        {
          "ui": { "type": "row", "dense": true },
          "elements": [
            {
              "ui": {
                "type": "button",
                "color": "primary",
                "icon": "tabler-checkbox",
                "size": "large"
              },
              "action": "save",
              "label": "Save Changes",
              "redirect": false
            },
            {
              "ui": {
                "type": "button",
                "color": "secondary",
                "variant": "tonal",
                "icon": "tabler-arrow-left"
              },
              "action": "cancel",
              "label": "Cancel",
              "redirect": "/module/modifier-groups"
            }
          ]
        }
      ]
    }
  }
}
