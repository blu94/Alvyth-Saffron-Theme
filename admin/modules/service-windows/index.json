{
    "expandable": false,
    "headerActions": {
        "elements": [
            {
                "key": "reload",
                "ui": {
                    "type": "button",
                    "icon": "tabler-refresh",
                    "color": "success",
                    "rounded": true
                },
                "tooltip": "Refresh List",
                "action": "reload",
                "class": "ms-2"
            },
            {
                "key": "create",
                "ui": {
                    "type": "button",
                    "icon": "tabler-plus",
                    "color": "primary",
                    "rounded": "md"
                },
                "label": "New Window",
                "tooltip": "Click to add an opening window",
                "action": "navigate",
                "to": "/module/service-windows/create"
            }
        ]
    },
    "filters": {
        "elements": [
            {
                "ui": { "type": "field" },
                "key": "kind",
                "label": "Entry Type",
                "placeholder": "Weekly hours and holidays",
                "type": "select",
                "options": {
                    "url": "/admin/modules/service-windows/options",
                    "master": "kind",
                    "params": { "columns[]": "kind" }
                }
            },
            {
                "ui": { "type": "field" },
                "key": "outlet",
                "label": "Branch",
                "placeholder": "All branches and the shop",
                "type": "select",
                "options": {
                    "url": "/admin/modules/service-windows/options",
                    "master": "outlet",
                    "params": { "columns[]": "outlet" }
                }
            },
            {
                "ui": { "type": "field" },
                "key": "day_of_week",
                "label": "Day",
                "placeholder": "Any day",
                "type": "select",
                "options": {
                    "url": "/admin/modules/service-windows/options",
                    "master": "day_of_week",
                    "params": { "columns[]": "day_of_week" }
                }
            },
            {
                "ui": { "type": "field" },
                "key": "mode",
                "label": "Mode",
                "placeholder": "Any mode",
                "type": "select",
                "options": {
                    "items": [
                        { "title": "Delivery", "value": "delivery" },
                        { "title": "Pickup", "value": "pickup" },
                        { "title": "Both", "value": "both" }
                    ]
                }
            },
            {
                "ui": { "type": "field" },
                "key": "status",
                "label": "Status",
                "placeholder": "Select Status",
                "type": "select",
                "options": {
                    "url": "/admin/modules/service-windows/options",
                    "master": "status"
                }
            }
        ]
    },
    "elements": [
        {
            "ui": { "type": "display" },
            "label": "ID",
            "key": "id",
            "sortable": true,
            "width": "60px"
        },
        {
            "ui": { "type": "display" },
            "label": "Type",
            "key": "kind",
            "type": "chip",
            "sortable": true
        },
        {
            "ui": { "type": "display" },
            "label": "Branch",
            "key": "branch_label",
            "sortable": false,
            "searchable": false
        },
        {
            "ui": { "type": "display" },
            "label": "Day",
            "key": "day_of_week",
            "sortable": true
        },
        {
            "ui": { "type": "display" },
            "label": "Date",
            "key": "date",
            "sortable": true
        },
        {
            "ui": { "type": "display" },
            "label": "Opens",
            "key": "opens_at",
            "sortable": true,
            "align": "center"
        },
        {
            "ui": { "type": "display" },
            "label": "Closes",
            "key": "closes_at",
            "sortable": true,
            "align": "center"
        },
        {
            "ui": { "type": "display" },
            "label": "Mode",
            "key": "mode",
            "sortable": true,
            "align": "center"
        },
        {
            "ui": { "type": "display" },
            "label": "Status",
            "key": "status",
            "sortable": false,
            "align": "center",
            "type": "status"
        }
    ],
    "actions": {
        "elements": [
            "view",
            "edit",
            {
                "key": "delete",
                "action": "delete",
                "ui": {
                    "type": "button",
                    "icon": "tabler-trash",
                    "color": "error",
                    "rounded": true
                },
                "params": {
                    "confirm": true,
                    "confirmText": "Delete this opening window?"
                }
            }
        ],
        "class": "fit"
    }
}
