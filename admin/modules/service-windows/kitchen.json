[
  {
    "ui": {
      "type": "section",
      "icon": "tabler-building-store",
      "cols": 12
    },
    "name": "Which Branch",
    "subtitle": "Narrow this board to the counter you are standing at. This device remembers the choice, so a tablet at one branch stays on that branch while the same login shows the whole shop elsewhere.",
    "elements": [
      {
        "ui": {
          "type": "field",
          "cols": {
            "cols": 12,
            "md": 4
          }
        },
        "key": "branch_id",
        "type": "select",
        "label": "Branch",
        "placeholder": "All branches",
        "hint": "Collection and dine-in tickets are narrowed to this branch. Delivery orders stay on every board — see the note beside this.",
        "options": {
          "url": "/admin/modules/service-windows/options",
          "master": "kitchen_branch",
          "params": { "columns[]": "kitchen_branch" }
        }
      },
      {
        "ui": {
          "type": "field",
          "cols": {
            "cols": 12,
            "md": 8
          },
          "icon": "tabler-info-circle",
          "color": "info",
          "valueClass": "text-body-2"
        },
        "type": "display",
        "key": "scope_notice",
        "label": "What this board is showing"
      }
    ]
  },
  {
    "ui": {
      "type": "section",
      "icon": "tabler-tools-kitchen-3",
      "cols": 12
    },
    "name": "Kitchen Queue",
    "subtitle": "Every open order, oldest first, with its options spelled out. Refreshes itself every 10 seconds, and announces a new order while Kitchen Alerts are on — the button above turns the chime on for this device.",
    "elements": [
      {
        "ui": {
          "type": "field",
          "cols": {
            "cols": 12,
            "sm": 6,
            "md": 3
          },
          "icon": "tabler-bell-ringing",
          "color": "primary"
        },
        "type": "display",
        "key": "count_new",
        "label": "New"
      },
      {
        "ui": {
          "type": "field",
          "cols": {
            "cols": 12,
            "sm": 6,
            "md": 3
          },
          "icon": "tabler-flame",
          "color": "warning"
        },
        "type": "display",
        "key": "count_preparing",
        "label": "Preparing"
      },
      {
        "ui": {
          "type": "field",
          "cols": {
            "cols": 12,
            "sm": 6,
            "md": 3
          },
          "icon": "tabler-bell-check",
          "color": "success"
        },
        "type": "display",
        "key": "count_ready",
        "label": "Ready"
      },
      {
        "ui": {
          "type": "field",
          "cols": {
            "cols": 12,
            "sm": 6,
            "md": 3
          },
          "icon": "tabler-moped",
          "color": "info"
        },
        "type": "display",
        "key": "count_out",
        "label": "Out For Delivery"
      },
      {
        "ui": {
          "type": "field",
          "cols": {
            "cols": 12,
            "sm": 6,
            "md": 3
          },
          "icon": "tabler-receipt",
          "color": "secondary"
        },
        "type": "display",
        "key": "total_open",
        "label": "Open Orders"
      },
      {
        "ui": {
          "type": "field",
          "cols": { "cols": 12 },
          "icon": "tabler-alert-triangle",
          "color": "warning"
        },
        "type": "display",
        "key": "queue_notice",
        "label": "Not everything is on this board"
      },
      {
        "ui": {
          "type": "field",
          "cols": {
            "cols": 12,
            "sm": 6,
            "md": 3
          },
          "icon": "tabler-calendar-event",
          "color": "info"
        },
        "type": "display",
        "key": "upcoming_count",
        "label": "Booked Ahead"
      },
      {
        "ui": {
          "type": "field",
          "cols": {
            "cols": 12,
            "sm": 6,
            "md": 6
          },
          "icon": "tabler-hourglass-high",
          "color": "error",
          "valueClass": "text-h6 font-weight-medium"
        },
        "type": "display",
        "key": "oldest",
        "label": "Longest Waiting"
      },
      {
        "ui": {
          "type": "field",
          "cols": {
            "cols": 12,
            "sm": 6,
            "md": 3
          },
          "icon": "tabler-clock",
          "color": "secondary",
          "valueClass": "text-body-1 font-weight-medium"
        },
        "type": "display",
        "key": "generated_at",
        "label": "Data As Of"
      }
    ]
  },
  {
    "ui": {
      "type": "section",
      "class": "h-100",
      "icon": "tabler-chart-donut",
      "cols": {
        "cols": 12,
        "md": 5
      }
    },
    "name": "Orders by state",
    "subtitle": "Where tonight's open orders are right now.",
    "elements": [
      {
        "ui": {
          "type": "field",
          "cols": 12
        },
        "type": "chart",
        "chart": "donut",
        "label": "Orders",
        "key": "orders_by_state",
        "unit": "order",
        "total": "Open",
        "height": 300,
        "empty": "No open orders."
      }
    ]
  },
  {
    "ui": {
      "type": "section",
      "class": "h-100",
      "icon": "tabler-hourglass",
      "cols": {
        "cols": 12,
        "md": 7
      }
    },
    "name": "Waiting longest",
    "subtitle": "Minutes since each order was placed — the top of this list is who to serve next.",
    "elements": [
      {
        "ui": {
          "type": "field",
          "cols": 12
        },
        "type": "chart",
        "chart": "bar",
        "horizontal": true,
        "label": "Waiting (min)",
        "key": "waiting_chart",
        "unit": "min",
        "height": 300,
        "empty": "Nothing waiting."
      }
    ]
  },
  {
    "ui": {
      "type": "section",
      "icon": "tabler-layout-columns",
      "cols": 12
    },
    "name": "The Queue",
    "subtitle": "One ticket per order, oldest first in each column: number, mode, waiting time, then every line with its options in brackets and the customer's note.",
    "elements": [
      {
        "ui": {
          "type": "field",
          "cols": 12
        },
        "type": "board",
        "key": "board",
        "label": "The Queue",
        "empty": "Nothing here."
      }
    ]
  },
  {
    "ui": {
      "type": "section",
      "icon": "tabler-calendar-event",
      "cols": 12
    },
    "name": "Booked Ahead",
    "subtitle": "Orders wanted on a later date, by the day they are for. They are kept out of the queue above until that morning, so a party three months away does not sit at the top of New ageing past today's lunch.",
    "elements": [
      {
        "ui": {
          "type": "field",
          "cols": 12,
          "valueClass": "text-body-2"
        },
        "type": "display",
        "key": "upcoming",
        "label": ""
      }
    ]
  },
  {
    "ui": {
      "type": "section",
      "icon": "tabler-arrow-right-circle",
      "cols": 12
    },
    "name": "Advance An Order",
    "subtitle": "Pick the order and the state it has reached, then Move Order. The order's status changes everywhere at once — the queue, Sales, and the customer's order history.",
    "elements": [
      {
        "ui": {
          "type": "field",
          "cols": {
            "cols": 12,
            "md": 5
          }
        },
        "key": "order_id",
        "type": "select",
        "label": "Order",
        "placeholder": "Choose an open order",
        "hint": "Follows the branch chosen above, plus any order that names no branch.",
        "options": {
          "url": "/admin/modules/service-windows/options",
          "master": "open_order",
          "params": { "columns[]": "open_order" },
          "dependsOn": "branch_id",
          "param": "branch_id"
        }
      },
      {
        "ui": {
          "type": "field",
          "cols": {
            "cols": 12,
            "md": 4
          }
        },
        "key": "to_state",
        "type": "select",
        "label": "Move To",
        "placeholder": "Choose the new state",
        "options": {
          "url": "/admin/modules/service-windows/options",
          "master": "kitchen_state",
          "params": { "columns[]": "kitchen_state" }
        }
      },
      {
        "ui": {
          "type": "button",
          "cols": {
            "cols": 12,
            "md": 3
          },
          "class": "align-self-end",
          "color": "primary"
        },
        "type": "button",
        "action": "save",
        "label": "Move Order",
        "icon": "tabler-arrow-right",
        "color": "primary"
      }
    ]
  }
]
