{
    "elements": [
        {
            "ui": {
                "type": "section",
                "cols": 12
            },
            "name": "The outlet",
            "elements": [
                {
                    "ui": {
                        "type": "field",
                        "cols": 12
                    },
                    "key": "title",
                    "type": "text",
                    "label": "Outlet Name",
                    "placeholder": "e.g. Bangsar",
                    "hint": "What a customer picking a branch will see. Translatable, so use the locale switcher above to add other languages",
                    "translatable": true,
                    "rules": [
                        "required"
                    ]
                },
                {
                    "ui": {
                        "type": "field",
                        "cols": 12
                    },
                    "key": "address",
                    "type": "textarea",
                    "label": "Collection Address",
                    "placeholder": "e.g. 12 Jalan Telawi, Bangsar, 59100 Kuala Lumpur",
                    "hint": "Shown to a customer collecting from here. Leave empty to fall back to the footer address"
                },
                {
                    "ui": {
                        "type": "field",
                        "cols": 6
                    },
                    "key": "phone",
                    "type": "text",
                    "label": "Phone",
                    "placeholder": "e.g. +60 3 1234 5678",
                    "hint": "Shown with the collection address. Include the country code so a customer can tap to call from a phone"
                },
                {
                    "ui": {
                        "type": "field",
                        "cols": 6
                    },
                    "key": "timezone",
                    "type": "text",
                    "label": "Timezone",
                    "placeholder": "e.g. Asia/Kuala_Lumpur",
                    "hint": "Recorded against the branch. Opening hours and order times are still judged in the shop's own timezone, set under Settings, so this changes nothing until per-branch hours ship"
                }
            ],
            "subtitle": "Who this branch is and how to reach it. The name is what a customer sees when they choose where to collect from, so use the name locals use — the district or mall, not the company's internal branch code."
        },
        {
            "ui": {
                "type": "section",
                "cols": 12
            },
            "name": "What this outlet serves",
            "elements": [
                {
                    "ui": {
                        "type": "field",
                        "cols": 12
                    },
                    "key": "restricts_menu",
                    "type": "switch",
                    "label": "This Outlet Serves Only Selected Dishes",
                    "hint": "Recorded for this branch, but the online menu does not filter by branch yet — a customer chooses where to collect from at the cart, after browsing. Set it now and it will apply when per-branch menus ship",
                    "default": false
                },
                {
                    "ui": {
                        "type": "field",
                        "cols": 12
                    },
                    "key": "product_ids",
                    "type": "autocomplete",
                    "label": "Dishes This Outlet Serves",
                    "placeholder": "Search the menu",
                    "hint": "Only consulted while the switch above is on",
                    "multiple": true,
                    "options": {
                        "url": "/admin/products/options",
                        "itemTitle": "title",
                        "itemValue": "id"
                    }
                }
            ],
            "subtitle": "By default every branch serves the whole menu, which is what most shops want. Restrict it only when a branch genuinely cannot make everything — a kiosk without a fryer, or a site that does drinks only. Note that the storefront menu does not yet vary by branch; this records the intent."
        },
        {
            "ui": {
                "type": "section",
                "cols": 12
            },
            "name": "How it takes orders",
            "elements": [
                {
                    "ui": {
                        "type": "field",
                        "cols": 12
                    },
                    "key": "offers_pickup",
                    "type": "switch",
                    "label": "Offers Collection",
                    "hint": "Customers may choose to collect from here",
                    "default": true
                },
                {
                    "ui": {
                        "type": "field",
                        "cols": 12
                    },
                    "key": "offers_delivery",
                    "type": "switch",
                    "label": "Offers Delivery",
                    "hint": "This outlet delivers to its own zones",
                    "default": true
                },
                {
                    "ui": {
                        "type": "field",
                        "cols": 12
                    },
                    "key": "is_default",
                    "type": "switch",
                    "label": "Default Outlet",
                    "hint": "The branch used for a customer who has not chosen one. Setting this here clears it from whichever outlet held it before",
                    "default": false
                }
            ],
            "subtitle": "Whether customers can collect from here, have it delivered from here, or both. A branch that offers neither takes no orders at all, so leave at least one on."
        },
        {
            "ui": {
                "type": "section",
                "cols": 12
            },
            "name": "Where it is",
            "elements": [
                {
                    "ui": {
                        "type": "field",
                        "cols": 6
                    },
                    "key": "latitude",
                    "type": "text",
                    "label": "Latitude",
                    "placeholder": "e.g. 3.1279",
                    "hint": "Between -90 and 90. Find it by right-clicking the branch in Google Maps and copying the first number"
                },
                {
                    "ui": {
                        "type": "field",
                        "cols": 6
                    },
                    "key": "longitude",
                    "type": "text",
                    "label": "Longitude",
                    "placeholder": "e.g. 101.6708",
                    "hint": "Between -180 and 180. The second of the two numbers Google Maps copies"
                }
            ],
            "subtitle": "Where this branch sits on the map, kept on the branch's own record. A delivery zone drawn by radius carries its own centre point, typed on the zone under Shipping — it does not read these, so filling them in changes no delivery charge today."
        }
    ],
    "sidebar": {
        "elements": [
            {
                "ui": {
                    "type": "row",
                    "dense": true
                },
                "elements": [
                    {
                        "ui": {
                            "type": "locale-switcher"
                        }
                    },
                    {
                        "ui": {
                            "type": "field"
                        },
                        "key": "slug",
                        "type": "text",
                        "label": "Slug",
                        "placeholder": "Leave empty and it is made from the name",
                        "rules": [
                            "nullable",
                            "string",
                            "max:255"
                        ],
                        "hint": "Used in links and kept unique automatically"
                    },
                    {
                        "ui": {
                            "type": "field"
                        },
                        "key": "status",
                        "type": "select",
                        "label": "Status",
                        "default": "active",
                        "options": {
                            "items": [
                                {
                                    "title": "Active",
                                    "value": "active"
                                },
                                {
                                    "title": "Inactive",
                                    "value": "inactive"
                                }
                            ]
                        },
                        "hint": "Inactive hides the branch from customers immediately but keeps it, and its orders, intact"
                    },
                    {
                        "ui": {
                            "type": "field"
                        },
                        "key": "orders",
                        "type": "number",
                        "label": "Display Order",
                        "placeholder": "e.g. 10",
                        "hint": "Lower sorts first, in the admin list and the customer's branch picker"
                    }
                ]
            }
        ],
        "footer": {
            "elements": [
                {
                    "ui": {
                        "type": "row",
                        "dense": true
                    },
                    "elements": [
                        {
                            "ui": {
                                "type": "button",
                                "color": "primary",
                                "icon": "tabler-checkbox"
                            },
                            "action": "save",
                            "label": "Save Changes",
                            "redirect": false
                        },
                        {
                            "ui": {
                                "type": "button",
                                "color": "secondary",
                                "variant": "tonal",
                                "icon": "tabler-arrow-left"
                            },
                            "action": "cancel",
                            "label": "Cancel",
                            "redirect": "/module/outlets"
                        }
                    ]
                }
            ]
        }
    }
}