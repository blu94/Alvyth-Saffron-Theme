{
  "ui": {
    "type": "tab",
    "name": "Header",
    "icon": "tabler-layout-navbar"
  },
  "name": "Header",
  "elements": [
    {
      "ui": {
        "type": "section",
        "cols": 12,
        "icon": "tabler-bell"
      },
      "name": "Announcement Bar",
      "elements": [
        {
          "ui": {
            "type": "field",
            "cols": 4
          },
          "key": "announcement_enabled",
          "type": "switch",
          "label": "Show Announcement Bar",
          "hint": "A single strip above the header",
          "default": true
        },
        {
          "ui": {
            "type": "field",
            "cols": 8
          },
          "key": "announcement_text",
          "type": "text",
          "label": "Announcement Text",
          "placeholder": "e.g. Free delivery on orders over RM40",
          "translatable": true,
          "default": "Free delivery on orders over RM40"
        },
        {
          "ui": {
            "type": "field",
            "cols": 6
          },
          "key": "announcementBg",
          "type": "color",
          "label": "Announcement Background",
          "default": "#1F1A17"
        },
        {
          "ui": {
            "type": "field",
            "cols": 6
          },
          "key": "announcementColor",
          "type": "color",
          "label": "Announcement Text Colour",
          "default": "#FFFDF8"
        }
      ]
    },
    {
      "ui": {
        "type": "section",
        "cols": 12,
        "icon": "tabler-photo"
      },
      "name": "Branding",
      "elements": [
        {
          "ui": {
            "type": "field",
            "cols": 12
          },
          "key": "header_logo",
          "type": "image",
          "label": "Logo",
          "hint": "Falls back to the site title when empty",
          "dropzoneOptions": {
            "usage": "THEME_LOGO"
          }
        },
        {
          "ui": {
            "type": "field",
            "cols": 6
          },
          "key": "header_logo_height",
          "type": "text",
          "label": "Logo Height",
          "placeholder": "e.g. 40px",
          "default": "40px"
        },
        {
          "ui": {
            "type": "field",
            "cols": 6
          },
          "key": "headerBg",
          "type": "color",
          "label": "Header Background",
          "default": "#FFFDF8"
        }
      ]
    },
    {
      "ui": {
        "type": "section",
        "cols": 12,
        "icon": "tabler-menu-2"
      },
      "name": "Navigation",
      "elements": [
        {
          "ui": {
            "type": "field",
            "cols": 12
          },
          "key": "header_links",
          "type": "repeater",
          "label": "Header Links",
          "itemLabel": "Link",
          "recursive": {
            "enabled": true,
            "key": "children",
            "label": "Sub-links / Blocks",
            "maxDepth": 6,
            "hidden_if": "item_type,promo|item_type,custom",
            "dialog": {
              "width": 900,
              "create": {
                "title": "Add Sub-link or Block",
                "subtitle": "A dropdown link, or — under a Mega Menu — a link column, a promotion banner or a custom block."
              },
              "update": {
                "title": "Edit Sub-link or Block"
              }
            }
          },
          "columns": [
            {
              "label": "Label",
              "key": "label"
            },
            {
              "label": "URL",
              "key": "url",
              "type": "link"
            },
            {
              "label": "Type",
              "key": "item_type"
            },
            {
              "label": "Status",
              "key": "status",
              "type": "status"
            }
          ],
          "dialog": {
            "width": 1000,
            "create": {
              "title": "Add Header Link",
              "subtitle": "A plain link, a link with a dropdown, or a Mega Menu whose sub-items become columns."
            },
            "update": {
              "title": "Edit Header Link",
              "subtitle": "For a Mega Menu, use the Sub-links / Blocks table to add link columns and promotion banners side by side."
            }
          },
          "elements": [
            {
              "ui": {
                "type": "field",
                "cols": 12,
                "hidden_if": "item_type,promo|item_type,custom"
              },
              "key": "label",
              "type": "text",
              "label": "Label",
              "placeholder": "e.g. Menu",
              "translatable": true
            },
            {
              "ui": {
                "type": "field",
                "cols": 12,
                "hidden_if": "menu_type,mega|item_type,promo|item_type,custom"
              },
              "key": "url",
              "type": "link",
              "label": "URL",
              "default": {
                "url": "",
                "type": "internal",
                "target": "_self"
              }
            },
            {
              "ui": {
                "type": "field",
                "cols": 6,
                "show_if": "depth,2"
              },
              "key": "menu_type",
              "type": "select",
              "label": "Menu Type",
              "hint": "Normal shows sub-links in a dropdown list. Mega spreads them as columns across a wide panel.",
              "default": "normal",
              "options": {
                "items": [
                  {
                    "title": "Normal Dropdown",
                    "value": "normal"
                  },
                  {
                    "title": "Mega Menu",
                    "value": "mega"
                  }
                ]
              }
            },
            {
              "ui": {
                "type": "field",
                "cols": 6,
                "show_if": "depth,2"
              },
              "key": "mega_menu_layout",
              "type": "select",
              "label": "Mega Layout",
              "hint": "Only used when Menu Type is Mega",
              "default": "full-width",
              "options": {
                "items": [
                  {
                    "title": "Full Width",
                    "value": "full-width"
                  },
                  {
                    "title": "Fixed Width",
                    "value": "fixed-width"
                  }
                ]
              }
            },
            {
              "ui": {
                "type": "field",
                "cols": 12,
                "show_if": "depth,4"
              },
              "key": "item_type",
              "type": "select",
              "label": "Item Type",
              "hint": "Under a Mega Menu: a link column (its own sub-links become the list), a promotion banner, or custom text/HTML. Under a Normal dropdown, leave as Link.",
              "default": "link",
              "options": {
                "items": [
                  {
                    "title": "Standard Link / Link Column",
                    "value": "link"
                  },
                  {
                    "title": "Promotion Banner",
                    "value": "promo"
                  },
                  {
                    "title": "Custom HTML / Text",
                    "value": "custom"
                  }
                ]
              }
            },
            {
              "ui": {
                "type": "field",
                "cols": 12,
                "show_if": "item_type,promo"
              },
              "key": "promo_image",
              "type": "image",
              "label": "Promo Image"
            },
            {
              "ui": {
                "type": "field",
                "cols": 6,
                "show_if": "item_type,promo"
              },
              "key": "promo_title",
              "type": "text",
              "label": "Promo Title",
              "placeholder": "e.g. Weekend set lunch",
              "translatable": true
            },
            {
              "ui": {
                "type": "field",
                "cols": 6,
                "show_if": "item_type,promo"
              },
              "key": "promo_button",
              "type": "text",
              "label": "Promo Button Text",
              "placeholder": "e.g. Order now",
              "translatable": true
            },
            {
              "ui": {
                "type": "field",
                "cols": 12,
                "show_if": "item_type,promo"
              },
              "key": "promo_url",
              "type": "link",
              "label": "Promo URL",
              "default": {
                "url": "",
                "type": "internal",
                "target": "_self"
              }
            },
            {
              "ui": {
                "type": "field",
                "cols": 12,
                "show_if": "item_type,custom"
              },
              "key": "custom_content",
              "type": "richtext",
              "label": "Custom Content",
              "placeholder": "Opening hours, a note, an announcement…",
              "translatable": true
            },
            {
              "ui": {
                "type": "field",
                "cols": 12
              },
              "key": "status",
              "type": "switch",
              "label": "Visible",
              "hint": "Turn off to hide this item without deleting it",
              "default": true
            }
          ]
        },
        {
          "ui": {
            "type": "field",
            "cols": 6
          },
          "key": "header_nav_position",
          "type": "select",
          "label": "Navigation Position",
          "hint": "Where the links sit between the logo and the icons",
          "options": {
            "items": [
              {
                "title": "Center",
                "value": "center"
              },
              {
                "title": "Beside the logo",
                "value": "left"
              }
            ]
          },
          "default": "center"
        },
        {
          "ui": {
            "type": "field",
            "cols": 6
          },
          "key": "header_show_search",
          "type": "switch",
          "label": "Show Search",
          "hint": "Search the menu from the header",
          "default": true
        },
        {
          "ui": {
            "type": "field",
            "cols": 6,
            "show_if": "header_show_search,true"
          },
          "key": "header_search_placeholder",
          "type": "text",
          "label": "Search Placeholder",
          "placeholder": "e.g. Search the menu",
          "hint": "The grey prompt inside the search box before anything is typed",
          "translatable": true
        },
        {
          "ui": {
            "type": "field",
            "cols": 6
          },
          "key": "header_show_cart",
          "type": "switch",
          "label": "Show Cart",
          "hint": "Cart count and link",
          "default": true
        },
        {
          "ui": {
            "type": "field",
            "cols": 6
          },
          "key": "header_show_locale_switcher",
          "type": "switch",
          "label": "Show Language Switcher",
          "hint": "A language menu beside the icons. Appears only when more than one locale is active in Settings → Localization",
          "default": true
        }
      ]
    },
    {
      "ui": {
        "type": "section",
        "cols": 12,
        "icon": "tabler-phone"
      },
      "name": "Order Call To Action",
      "elements": [
        {
          "ui": {
            "type": "field",
            "cols": 6
          },
          "key": "header_cta_label",
          "type": "text",
          "label": "Button Label",
          "placeholder": "e.g. Order Now",
          "hint": "Leave empty to hide the button",
          "translatable": true,
          "default": "Order Now"
        },
        {
          "ui": {
            "type": "field",
            "cols": 6
          },
          "key": "header_cta_url",
          "type": "link",
          "label": "Button URL",
          "default": {
            "url": "/menu",
            "type": "internal",
            "target": "_self"
          }
        }
      ]
    }
  ]
}
