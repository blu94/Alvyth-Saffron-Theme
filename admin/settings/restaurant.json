{
  "ui": {
    "type": "tab",
    "name": "Restaurant",
    "icon": "tabler-tools-kitchen-2"
  },
  "name": "Restaurant",
  "elements": [
    {
      "ui": {
        "type": "section",
        "cols": 12,
        "icon": "tabler-list-details"
      },
      "name": "Menu Presentation",
      "elements": [
        {
          "ui": {
            "type": "field",
            "cols": 6
          },
          "key": "menu_layout",
          "type": "select",
          "label": "Menu Layout",
          "hint": "Grid suits photographed dishes; list suits long menus",
          "options": {
            "items": [
              { "title": "Grid", "value": "grid" },
              { "title": "List", "value": "list" }
            ]
          },
          "default": "grid"
        },
        {
          "ui": {
            "type": "field",
            "cols": 6
          },
          "key": "menu_columns",
          "type": "select",
          "label": "Dishes Per Row (Desktop)",
          "hint": "Ignored when the layout is set to list",
          "options": {
            "items": [
              { "title": "2", "value": "2" },
              { "title": "3", "value": "3" },
              { "title": "4", "value": "4" }
            ]
          },
          "default": "3"
        },
        {
          "ui": {
            "type": "field",
            "cols": 6
          },
          "key": "dish_image_ratio",
          "type": "select",
          "label": "Dish Image Ratio",
          "hint": "Applied to every dish card so a mixed-aspect photo set still lines up",
          "options": {
            "items": [
              { "title": "Square (1:1)", "value": "1/1" },
              { "title": "Landscape (4:3)", "value": "4/3" },
              { "title": "Wide (16:9)", "value": "16/9" },
              { "title": "Portrait (3:4)", "value": "3/4" }
            ]
          },
          "default": "4/3"
        },
        {
          "ui": {
            "type": "field",
            "cols": 6
          },
          "key": "dish_show_price",
          "type": "switch",
          "label": "Show Prices On Dish Cards",
          "hint": "Turn off for a menu priced only on the dish page",
          "default": true
        },
        {
          "ui": {
            "type": "field",
            "cols": 6
          },
          "key": "dish_show_tags",
          "type": "switch",
          "label": "Show Tags As Badges",
          "hint": "Spicy, New, Halal, Vegan — read from the dish's tags",
          "default": true
        },
        {
          "ui": {
            "type": "field",
            "cols": 6
          },
          "key": "dish_show_description",
          "type": "switch",
          "label": "Show Short Description",
          "hint": "One clamped line under the dish name",
          "default": true
        },
        {
          "ui": {
            "type": "field",
            "cols": 12
          },
          "key": "menu_sticky_nav",
          "type": "switch",
          "label": "Sticky Section Navigation",
          "hint": "Pin the menu-section jump links while the customer scrolls",
          "default": true
        }
      ]
    },
    {
      "ui": {
        "type": "section",
        "cols": 12,
        "icon": "tabler-moped"
      },
      "name": "Ordering Modes",
      "elements": [
        {
          "ui": {
            "type": "field",
            "cols": 4
          },
          "key": "mode_delivery_enabled",
          "type": "switch",
          "label": "Offer Delivery",
          "hint": "Priced through the existing shipping zones and methods",
          "default": true
        },
        {
          "ui": {
            "type": "field",
            "cols": 4
          },
          "key": "mode_pickup_enabled",
          "type": "switch",
          "label": "Offer Pickup",
          "hint": "No address and no fee. See the warning below before enabling with delivery",
          "default": true
        },
        {
          "ui": {
            "type": "field",
            "cols": 4
          },
          "key": "mode_dinein_enabled",
          "type": "switch",
          "label": "Offer Dine-In",
          "hint": "Table number is captured at checkout",
          "default": false
        },
        {
          "ui": {
            "type": "field",
            "cols": 12
          },
          "key": "mode_notice",
          "type": "textarea",
          "label": "Ordering Mode Notice",
          "placeholder": "e.g. Delivery within 5 km. Pickup ready at the counter.",
          "hint": "Shown above the mode picker. Note that only one mode is enforced at checkout today — whether an address is demanded is decided by each dish's shipping flag, not by the mode the customer picked.",
          "translatable": true,
          "default": ""
        }
      ]
    },
    {
      "ui": {
        "type": "section",
        "cols": 12,
        "icon": "tabler-clock-hour-4"
      },
      "name": "Timing & Availability Wording",
      "elements": [
        {
          "ui": {
            "type": "field",
            "cols": 6
          },
          "key": "prep_time_label",
          "type": "text",
          "label": "Prep Time Wording",
          "placeholder": "e.g. Ready in about 25–35 min",
          "hint": "Shown wherever an ASAP order is described",
          "translatable": true,
          "default": "Ready in about 25–35 min"
        },
        {
          "ui": {
            "type": "field",
            "cols": 6
          },
          "key": "sold_out_label",
          "type": "text",
          "label": "Sold Out Wording",
          "placeholder": "e.g. Sold out for today",
          "hint": "Shown on a dish that is no longer active",
          "translatable": true,
          "default": "Sold out for today"
        },
        {
          "ui": {
            "type": "field",
            "cols": 12
          },
          "key": "closed_message",
          "type": "textarea",
          "label": "Closed Shop Message",
          "placeholder": "e.g. We're closed right now — browse the menu and order when we open at 11am.",
          "hint": "Presentation only until service-window enforcement lands in core",
          "translatable": true,
          "default": "We're closed right now — browse the menu and we'll take your order when we reopen."
        }
      ]
    },
    {
      "ui": {
        "type": "section",
        "cols": 12,
        "icon": "tabler-star"
      },
      "name": "Reviews",
      "elements": [
        {
          "ui": {
            "type": "field",
            "cols": 12
          },
          "key": "review_prompt_enabled",
          "type": "switch",
          "label": "Show Review Prompt",
          "hint": "Invite a rating after an order is marked delivered",
          "default": true
        }
      ]
    }
  ]
}
