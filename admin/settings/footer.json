{
  "ui": {
    "type": "tab",
    "name": "Footer",
    "icon": "tabler-layout-bottombar"
  },
  "name": "Footer",
  "elements": [
    {
      "ui": {
        "type": "section",
        "cols": 12,
        "icon": "tabler-layout-grid"
      },
      "name": "Layout",
      "subtitle": "Compose the footer from rows of columns. Each column holds one or more blocks that draw from the content sections below — the address, links, socials and legals are edited once and placed anywhere. Leave the layout empty to use the built-in three-column arrangement.",
      "elements": [
        {
          "ui": {
            "type": "field",
            "cols": 12
          },
          "key": "footer_rows",
          "type": "repeater",
          "label": "Rows",
          "itemLabel": "Row",
          "columns": [
            { "label": "Row Label", "key": "label" },
            { "label": "Style", "key": "style" }
          ],
          "dialog": {
            "width": 1100,
            "create": { "title": "Add Footer Row", "subtitle": "A full-width band. Add columns inside it, then blocks inside each column." },
            "update": { "title": "Edit Footer Row", "subtitle": "Columns share the row's width by their span (12 = full width, 6 = half, 4 = a third, 3 = a quarter)." }
          },
          "elements": [
            {
              "ui": { "type": "field", "cols": 6 },
              "key": "label",
              "type": "text",
              "label": "Row Label",
              "placeholder": "e.g. Main, Newsletter, Legal",
              "hint": "For your own reference in this list; never shown to customers"
            },
            {
              "ui": { "type": "field", "cols": 6 },
              "key": "style",
              "type": "select",
              "label": "Row Style",
              "options": {
                "items": [
                  { "title": "Standard", "value": "standard" },
                  { "title": "Divider above", "value": "divided" },
                  { "title": "Compact bar (legal line)", "value": "bar" }
                ]
              },
              "default": "standard"
            },
            {
              "ui": { "type": "field", "cols": 12 },
              "key": "columns",
              "type": "repeater",
              "label": "Columns",
              "itemLabel": "Column",
              "columns": [
                { "label": "Heading", "key": "heading" },
                { "label": "Span", "key": "span" }
              ],
              "dialog": {
                "width": 900,
                "create": { "title": "Add Column" },
                "update": { "title": "Edit Column" }
              },
              "elements": [
                {
                  "ui": { "type": "field", "cols": 8 },
                  "key": "heading",
                  "type": "text",
                  "label": "Column Heading",
                  "placeholder": "e.g. Find us, Discover, Opening time",
                  "hint": "Optional. Small uppercase label above the column's blocks",
                  "translatable": true
                },
                {
                  "ui": { "type": "field", "cols": 4 },
                  "key": "span",
                  "type": "select",
                  "label": "Width",
                  "options": {
                    "items": [
                      { "title": "Full (12)", "value": "12" },
                      { "title": "Two thirds (8)", "value": "8" },
                      { "title": "Half (6)", "value": "6" },
                      { "title": "Third (4)", "value": "4" },
                      { "title": "Quarter (3)", "value": "3" }
                    ]
                  },
                  "default": "4"
                },
                {
                  "ui": { "type": "field", "cols": 12 },
                  "key": "blocks",
                  "type": "repeater",
                  "label": "Blocks",
                  "itemLabel": "Block",
                  "columns": [
                    { "label": "Type", "key": "type" },
                    { "label": "Title", "key": "title" }
                  ],
                  "dialog": {
                    "width": 700,
                    "create": { "title": "Add Block", "subtitle": "What this column shows. Blocks stack top to bottom." },
                    "update": { "title": "Edit Block" }
                  },
                  "elements": [
                    {
                      "ui": { "type": "field", "cols": 12 },
                      "key": "type",
                      "type": "select",
                      "label": "Block Type",
                      "options": {
                        "items": [
                          { "title": "Brand — logo/name and tagline", "value": "brand" },
                          { "title": "Contact — address, phone, hours (from Outlet)", "value": "contact" },
                          { "title": "Links — the Footer Links list", "value": "links" },
                          { "title": "Social channels", "value": "socials" },
                          { "title": "Text — a paragraph or rich text", "value": "text" },
                          { "title": "Form — any form built in Forms", "value": "form" },
                          { "title": "Copyright line (from Legals)", "value": "copyright" }
                        ]
                      },
                      "default": "links"
                    },
                    {
                      "ui": { "type": "field", "cols": 12, "hidden_if": "type,copyright|type,socials" },
                      "key": "title",
                      "type": "text",
                      "label": "Block Title",
                      "placeholder": "e.g. Be the first to hear our stories",
                      "hint": "Optional heading shown above this block",
                      "translatable": true
                    },
                    {
                      "ui": { "type": "field", "cols": 12, "show_if": "type,text" },
                      "key": "content",
                      "type": "richtext",
                      "label": "Text",
                      "placeholder": "Receive thoughtful updates, seasonal inspirations, and moments worth sharing.",
                      "translatable": true
                    },
                    {
                      "ui": { "type": "field", "cols": 12, "show_if": "type,form" },
                      "key": "form_slug",
                      "type": "autocomplete",
                      "label": "Form",
                      "hint": "Any active form from the Forms module. It renders inline and submits to the same place its leads always go.",
                      "placeholder": "Search forms…",
                      "options": {
                        "url": "/admin/forms",
                        "master": "data",
                        "map": { "title": "title", "value": "slug" }
                      }
                    },
                    {
                      "ui": { "type": "field", "cols": 12, "show_if": "type,form" },
                      "key": "form_intro",
                      "type": "textarea",
                      "label": "Form Intro",
                      "placeholder": "A line above the form",
                      "translatable": true
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "ui": {
        "type": "section",
        "cols": 12,
        "icon": "tabler-map-pin"
      },
      "name": "Outlet",
      "elements": [
        {
          "ui": {
            "type": "field",
            "cols": 12
          },
          "key": "footer_tagline",
          "type": "text",
          "label": "Tagline",
          "placeholder": "e.g. Slow-cooked, fast-served.",
          "translatable": true,
          "default": ""
        },
        {
          "ui": {
            "type": "field",
            "cols": 12
          },
          "key": "footer_address",
          "type": "textarea",
          "label": "Outlet Address",
          "placeholder": "e.g. 12 Jalan Bukit Bintang, 55100 Kuala Lumpur",
          "hint": "Shown in the footer. The pickup address used at checkout is a separate operational setting",
          "translatable": true,
          "default": ""
        },
        {
          "ui": {
            "type": "field",
            "cols": 6
          },
          "key": "footer_phone",
          "type": "text",
          "label": "Phone",
          "placeholder": "e.g. +60 3-1234 5678",
          "default": ""
        },
        {
          "ui": {
            "type": "field",
            "cols": 6
          },
          "key": "footer_hours",
          "type": "text",
          "label": "Opening Hours Summary",
          "placeholder": "e.g. Daily 11am – 10pm",
          "hint": "Free text. Enforced service windows are a later phase",
          "translatable": true,
          "default": ""
        }
      ]
    },
    {
      "ui": {
        "type": "section",
        "cols": 12,
        "icon": "tabler-link"
      },
      "name": "Footer Links",
      "elements": [
        {
          "ui": {
            "type": "field",
            "cols": 12
          },
          "key": "footer_links",
          "type": "repeater",
          "label": "Links",
          "itemLabel": "Link",
          "default": [
            { "label": { "en": "Menu" }, "url": { "url": "/collections", "type": "internal", "target": "_self" } },
            { "label": { "en": "Blog" }, "url": { "url": "/blogs", "type": "internal", "target": "_self" } },
            { "label": { "en": "My Account" }, "url": { "url": "/profile", "type": "internal", "target": "_self" } },
            { "label": { "en": "Cart" }, "url": { "url": "/cart", "type": "internal", "target": "_self" } }
          ],
          "columns": [
            { "label": "Label", "key": "label" },
            { "label": "URL", "key": "url" }
          ],
          "dialog": {
            "width": 600,
            "create": { "title": "Add Footer Link" },
            "update": { "title": "Edit Footer Link" }
          },
          "elements": [
            {
              "ui": {
                "type": "field",
                "cols": 12
              },
              "key": "label",
              "type": "text",
              "label": "Label",
              "placeholder": "e.g. Delivery Areas",
              "translatable": true,
              "rules": ["required"]
            },
            {
              "ui": {
                "type": "field",
                "cols": 12
              },
              "key": "url",
              "type": "link",
              "label": "URL",
              "default": {
                "url": "",
                "type": "internal",
                "target": "_self"
              }
            }
          ]
        }
      ]
    },
    {
      "ui": {
        "type": "section",
        "cols": 12,
        "icon": "tabler-share"
      },
      "name": "Social Presence",
      "elements": [
        {
          "ui": {
            "type": "field",
            "cols": 12
          },
          "key": "footer_socials",
          "type": "repeater",
          "label": "Social Channels",
          "itemLabel": "Social Link",
          "columns": [
            { "label": "Icon", "key": "icon" },
            { "label": "URL", "key": "url" }
          ],
          "dialog": {
            "width": 600,
            "create": { "title": "Add Social Channel" },
            "update": { "title": "Edit Social Channel" }
          },
          "elements": [
            {
              "ui": {
                "type": "field",
                "cols": 12
              },
              "key": "icon",
              "type": "icon",
              "label": "Icon",
              "default": "tabler-brand-instagram"
            },
            {
              "ui": {
                "type": "field",
                "cols": 12
              },
              "key": "url",
              "type": "link",
              "label": "Link URL",
              "default": {
                "url": "",
                "type": "external",
                "target": "_blank"
              }
            }
          ]
        }
      ]
    },
    {
      "ui": {
        "type": "section",
        "cols": 12,
        "icon": "tabler-copyright"
      },
      "name": "Legals",
      "elements": [
        {
          "ui": {
            "type": "field",
            "cols": 12
          },
          "key": "footer_copyright",
          "type": "text",
          "label": "Copyright Text",
          "placeholder": "e.g. © 2026 Nasi Lemak House. All rights reserved.",
          "translatable": true,
          "default": "© 2026 Alvyth. All rights reserved."
        }
      ]
    }
  ]
}
