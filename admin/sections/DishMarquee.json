{
    "type": "DISH_MARQUEE_SECTION",
    "component": "DishMarqueeSection",
    "name": "Dish Marquee",
    "description": "A strip of signature dishes that glides across the page — photo, name, a line of description and the price, looping endlessly.",
    "ui": {
        "icon": "tabler-carousel-horizontal"
    },
    "contents": {
        "elements": [
            {
                "ui": { "type": "field", "cols": 12 },
                "key": "heading",
                "type": "text",
                "label": "Heading",
                "placeholder": "e.g. Signature Dishes",
                "translatable": true,
                "default": "Signature Dishes"
            },
            {
                "ui": { "type": "field", "cols": 12 },
                "key": "subheading",
                "type": "textarea",
                "label": "Subheading",
                "placeholder": "e.g. The plates our regulars come back for.",
                "translatable": true
            },
            {
                "ui": { "type": "field", "cols": 6 },
                "key": "source",
                "type": "select",
                "label": "Pick Dishes By",
                "hint": "Category and tag are matched on slug",
                "options": {
                    "items": [
                        { "title": "Newest Dishes", "value": "latest" },
                        { "title": "Category Slug", "value": "category" },
                        { "title": "Tag Slug", "value": "tag" }
                    ]
                },
                "default": "latest"
            },
            {
                "ui": { "type": "field", "cols": 6 },
                "key": "source_slug",
                "type": "text",
                "label": "Category Or Tag Slug",
                "placeholder": "e.g. signature",
                "hint": "Required when picking by category or tag",
                "default": ""
            },
            {
                "ui": { "type": "field", "cols": 12 },
                "key": "cta_label",
                "type": "text",
                "label": "Footer Link Label",
                "placeholder": "e.g. View the full menu",
                "hint": "Leave empty to hide the link",
                "translatable": true,
                "default": ""
            },
            {
                "ui": { "type": "field", "cols": 12 },
                "key": "cta_url",
                "type": "link",
                "label": "Footer Link URL",
                "default": {
                    "url": "/menu",
                    "type": "internal",
                    "target": "_self"
                }
            }
        ]
    },
    "settings": {
        "elements": [
            {
                "ui": { "type": "tabs", "cols": 12, "icon": "tabler-settings" },
                "elements": [
                    {
                        "ui": { "type": "tab", "name": "General", "icon": "tabler-info-circle" },
                        "name": "General",
                        "elements": [
                            {
                                "ui": { "type": "field", "cols": 6 },
                                "key": "limit",
                                "type": "number",
                                "label": "How Many Dishes",
                                "placeholder": "e.g. 8",
                                "hint": "The strip repeats them to fill the width, so six to ten is plenty",
                                "default": 8
                            },
                            {
                                "ui": { "type": "field", "cols": 6 },
                                "key": "card_size",
                                "type": "select",
                                "label": "Card Size",
                                "options": {
                                    "items": [
                                        { "title": "Compact", "value": "compact" },
                                        { "title": "Regular", "value": "regular" },
                                        { "title": "Large", "value": "large" }
                                    ]
                                },
                                "default": "regular"
                            },
                            {
                                "ui": { "type": "field", "cols": 6 },
                                "key": "speed",
                                "type": "select",
                                "label": "Glide Speed",
                                "hint": "How long one full pass takes",
                                "options": {
                                    "items": [
                                        { "title": "Leisurely (60s)", "value": "60" },
                                        { "title": "Normal (40s)", "value": "40" },
                                        { "title": "Brisk (25s)", "value": "25" }
                                    ]
                                },
                                "default": "40"
                            },
                            {
                                "ui": { "type": "field", "cols": 6 },
                                "key": "direction",
                                "type": "select",
                                "label": "Direction",
                                "options": {
                                    "items": [
                                        { "title": "Right to left", "value": "left" },
                                        { "title": "Left to right", "value": "right" }
                                    ]
                                },
                                "default": "left"
                            },
                            {
                                "ui": { "type": "field", "cols": 6 },
                                "key": "pause_on_hover",
                                "type": "switch",
                                "label": "Pause On Hover",
                                "hint": "The strip stops while the pointer rests on it, so a dish can be read and clicked",
                                "default": true
                            },
                            {
                                "ui": { "type": "field", "cols": 6 },
                                "key": "status",
                                "type": "select",
                                "label": "Status",
                                "options": {
                                    "items": [
                                        { "title": "Active", "value": "active" },
                                        { "title": "Disabled", "value": "disabled" }
                                    ]
                                },
                                "default": "active"
                            },
                            {
                                "ui": { "type": "field", "cols": 6 },
                                "key": "show_price",
                                "type": "switch",
                                "label": "Show Price",
                                "default": true
                            },
                            {
                                "ui": { "type": "field", "cols": 6 },
                                "key": "show_description",
                                "type": "switch",
                                "label": "Show Description",
                                "hint": "The first line or two of the dish description",
                                "default": true
                            }
                        ]
                    },
                    {
                        "ui": { "type": "tab", "name": "Styling", "icon": "tabler-palette" },
                        "name": "Styling",
                        "elements": [
                            {
                                "ui": { "type": "row", "cols": 12 },
                                "elements": [
                                    {
                                        "ui": { "type": "field", "cols": 6 },
                                        "key": "data.style.section.id",
                                        "type": "text",
                                        "label": "Custom CSS ID",
                                        "placeholder": "e.g. signature-dishes"
                                    },
                                    {
                                        "ui": { "type": "field", "cols": 6 },
                                        "key": "data.style.section.class",
                                        "type": "text",
                                        "label": "Custom CSS Class",
                                        "placeholder": "e.g. my-marquee"
                                    }
                                ]
                            },
                            {
                                "ui": { "type": "row", "cols": 12 },
                                "elements": [
                                    {
                                        "ui": { "type": "field", "cols": 6 },
                                        "key": "animation",
                                        "type": "select",
                                        "label": "Scroll Animation",
                                        "hint": "How this section eases into view. Theme default follows Themes → Settings → Animation; None keeps it static",
                                        "options": {
                                            "items": [
                                                { "title": "Theme default", "value": "inherit" },
                                                { "title": "None", "value": "none" },
                                                { "title": "Fade up", "value": "fade-up" },
                                                { "title": "Fade down", "value": "fade-down" },
                                                { "title": "Fade in", "value": "fade-in" },
                                                { "title": "Fade from left", "value": "fade-left" },
                                                { "title": "Fade from right", "value": "fade-right" },
                                                { "title": "Zoom in", "value": "zoom-in" },
                                                { "title": "Fade & un-blur", "value": "fade-blur" }
                                            ]
                                        },
                                        "default": "inherit"
                                    },
                                    {
                                        "ui": { "type": "field", "cols": 6 },
                                        "key": "animation_duration",
                                        "type": "select",
                                        "label": "Animation Speed",
                                        "hint": "How long each element takes to appear",
                                        "options": {
                                            "items": [
                                                { "title": "Theme default", "value": "inherit" },
                                                { "title": "Fast (0.4s)", "value": "400" },
                                                { "title": "Normal (0.7s)", "value": "700" },
                                                { "title": "Slow (1s)", "value": "1000" },
                                                { "title": "Very slow (1.4s)", "value": "1400" }
                                            ]
                                        },
                                        "default": "inherit"
                                    },
                                    {
                                        "ui": { "type": "field", "cols": 6 },
                                        "key": "animation_stagger",
                                        "type": "select",
                                        "label": "Stagger Between Items",
                                        "hint": "Gap between one item and the next when several appear together",
                                        "options": {
                                            "items": [
                                                { "title": "Theme default", "value": "inherit" },
                                                { "title": "None — all together", "value": "0" },
                                                { "title": "Subtle (60ms)", "value": "60" },
                                                { "title": "Normal (100ms)", "value": "100" },
                                                { "title": "Relaxed (160ms)", "value": "160" }
                                            ]
                                        },
                                        "default": "inherit"
                                    },
                                    {
                                        "ui": { "type": "field", "cols": 6 },
                                        "key": "animation_delay",
                                        "type": "number",
                                        "label": "Animation Delay (ms)",
                                        "placeholder": "e.g. 0",
                                        "hint": "Wait this long after the section scrolls into view before it starts",
                                        "default": 0
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    }
}
