{
    "type": "STORE_STATUS_SECTION",
    "component": "StoreStatusSection",
    "name": "Store Status",
    "description": "Open / closed / opens-at banner, read from the theme's service windows — the same hours checkout enforces, so what this says and what the server accepts agree.",
    "ui": {
        "icon": "tabler-clock-hour-9"
    },
    "contents": {
        "elements": [
            {
                "ui": { "type": "field", "cols": 12 },
                "key": "closed_message",
                "type": "textarea",
                "label": "Closed Message",
                "placeholder": "Leave empty to use the theme setting",
                "hint": "Falls back to Theme Settings → Restaurant → Closed Shop Message",
                "translatable": true,
                "default": ""
            },
            {
                "ui": { "type": "field", "cols": 12 },
                "key": "open_message",
                "type": "text",
                "label": "Open Message",
                "placeholder": "e.g. Taking orders now",
                "translatable": true,
                "default": ""
            }
        ]
    },
    "settings": {
        "elements": [
            {
                "ui": { "type": "tabs", "cols": 12, "icon": "tabler-settings" },
                "elements": [
                    {
                        "ui": { "type": "tab", "name": "General", "icon": "tabler-info-circle" },
                        "name": "General",
                        "elements": [
                            {
                                "ui": { "type": "field", "cols": 6 },
                                "key": "show_when_open",
                                "type": "switch",
                                "label": "Show Banner While Open",
                                "hint": "Off shows the banner only when the shop is closed",
                                "default": false
                            },
                            {
                                "ui": { "type": "field", "cols": 6 },
                                "key": "timezone",
                                "type": "autocomplete",
                                "label": "Shop Timezone",
                                "placeholder": "e.g. Asia/Kuala_Lumpur",
                                "clearable": true,
                                "options": { "$ref": "../shared/timezones.json" },
                                "hint": "An IANA name. Empty uses the application timezone. Windows are compared in this zone, so a 09:00 opening is 09:00 here whatever the season",
                                "default": ""
                            },
                            {
                                "ui": { "type": "field", "cols": 12 },
                                "key": "status",
                                "type": "select",
                                "label": "Status",
                                "options": {
                                    "items": [
                                        { "title": "Active", "value": "active" },
                                        { "title": "Disabled", "value": "disabled" }
                                    ]
                                },
                                "default": "active"
                            }
                        ]
                    },
                    {
                        "ui": { "type": "tab", "name": "Styling", "icon": "tabler-palette" },
                        "name": "Styling",
                        "elements": [
                            {
                                "ui": { "type": "row", "cols": 12 },
                                "elements": [
                                    {
                                        "ui": { "type": "field", "cols": 6 },
                                        "key": "data.style.section.id",
                                        "type": "text",
                                        "label": "Custom CSS ID",
                                        "placeholder": "e.g. store-status"
                                    },
                                    {
                                        "ui": { "type": "field", "cols": 6 },
                                        "key": "data.style.section.class",
                                        "type": "text",
                                        "label": "Custom CSS Class",
                                        "placeholder": "e.g. my-status"
                                    }
                                ]
                            },
                            {
                                "ui": { "type": "row", "cols": 12 },
                                "elements": [
                                    {
                                        "ui": { "type": "field", "cols": 6 },
                                        "key": "animation",
                                        "type": "select",
                                        "label": "Scroll Animation",
                                        "hint": "How this section eases into view. Theme default follows Themes → Settings → Animation; None keeps it static",
                                        "options": {
                                            "items": [
                                                { "title": "Theme default", "value": "inherit" },
                                                { "title": "None", "value": "none" },
                                                { "title": "Fade up", "value": "fade-up" },
                                                { "title": "Fade down", "value": "fade-down" },
                                                { "title": "Fade in", "value": "fade-in" },
                                                { "title": "Fade from left", "value": "fade-left" },
                                                { "title": "Fade from right", "value": "fade-right" },
                                                { "title": "Zoom in", "value": "zoom-in" },
                                                { "title": "Fade & un-blur", "value": "fade-blur" }
                                            ]
                                        },
                                        "default": "inherit"
                                    },
                                    {
                                        "ui": { "type": "field", "cols": 6 },
                                        "key": "animation_duration",
                                        "type": "select",
                                        "label": "Animation Speed",
                                        "hint": "How long each element takes to appear",
                                        "options": {
                                            "items": [
                                                { "title": "Theme default", "value": "inherit" },
                                                { "title": "Fast (0.4s)", "value": "400" },
                                                { "title": "Normal (0.7s)", "value": "700" },
                                                { "title": "Slow (1s)", "value": "1000" },
                                                { "title": "Very slow (1.4s)", "value": "1400" }
                                            ]
                                        },
                                        "default": "inherit"
                                    },
                                    {
                                        "ui": { "type": "field", "cols": 6 },
                                        "key": "animation_stagger",
                                        "type": "select",
                                        "label": "Stagger Between Items",
                                        "hint": "Gap between one item and the next when several appear together",
                                        "options": {
                                            "items": [
                                                { "title": "Theme default", "value": "inherit" },
                                                { "title": "None — all together", "value": "0" },
                                                { "title": "Subtle (60ms)", "value": "60" },
                                                { "title": "Normal (100ms)", "value": "100" },
                                                { "title": "Relaxed (160ms)", "value": "160" }
                                            ]
                                        },
                                        "default": "inherit"
                                    },
                                    {
                                        "ui": { "type": "field", "cols": 6 },
                                        "key": "animation_delay",
                                        "type": "number",
                                        "label": "Animation Delay (ms)",
                                        "placeholder": "e.g. 0",
                                        "hint": "Wait this long after the section scrolls into view before it starts",
                                        "default": 0
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    }
}
