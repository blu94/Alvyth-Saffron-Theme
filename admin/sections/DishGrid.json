{
    "type": "DISH_GRID_SECTION",
    "component": "DishGridSection",
    "name": "Dish Grid",
    "description": "One curated row of dishes — Most Popular, New This Week, Chef's Picks.",
    "ui": {
        "icon": "tabler-bowl-spoon"
    },
    "contents": {
        "elements": [
            {
                "ui": { "type": "field", "cols": 12 },
                "key": "heading",
                "type": "text",
                "label": "Heading",
                "placeholder": "e.g. Most Popular",
                "translatable": true,
                "default": "Most Popular"
            },
            {
                "ui": { "type": "field", "cols": 12 },
                "key": "subheading",
                "type": "textarea",
                "label": "Subheading",
                "placeholder": "e.g. What everyone orders twice.",
                "translatable": true
            },
            {
                "ui": { "type": "field", "cols": 6 },
                "key": "source",
                "type": "select",
                "label": "Pick Dishes By",
                "hint": "Category and tag are matched on slug",
                "options": {
                    "items": [
                        { "title": "Newest Dishes", "value": "latest" },
                        { "title": "Category Slug", "value": "category" },
                        { "title": "Tag Slug", "value": "tag" }
                    ]
                },
                "default": "latest"
            },
            {
                "ui": { "type": "field", "cols": 6 },
                "key": "source_slug",
                "type": "text",
                "label": "Category Or Tag Slug",
                "placeholder": "e.g. burgers",
                "hint": "Required when picking by category or tag",
                "default": ""
            },
            {
                "ui": { "type": "field", "cols": 12 },
                "key": "cta_label",
                "type": "text",
                "label": "Footer Link Label",
                "placeholder": "e.g. See the full menu",
                "hint": "Leave empty to hide the link",
                "translatable": true,
                "default": ""
            },
            {
                "ui": { "type": "field", "cols": 12 },
                "key": "cta_url",
                "type": "link",
                "label": "Footer Link URL",
                "default": {
                    "url": "/menu",
                    "type": "internal",
                    "target": "_self"
                }
            }
        ]
    },
    "settings": {
        "elements": [
            {
                "ui": {
                    "type": "tabs",
                    "cols": 12,
                    "icon": "tabler-settings"
                },
                "elements": [
                    {
                        "ui": {
                            "type": "tab",
                            "name": "General",
                            "icon": "tabler-info-circle"
                        },
                        "name": "General",
                        "elements": [
                            {
                                "ui": { "type": "field", "cols": 6 },
                                "key": "layout",
                                "type": "select",
                                "label": "Dish Layout",
                                "options": {
                                    "items": [
                                        { "title": "Grid", "value": "grid" },
                                        { "title": "List", "value": "list" }
                                    ]
                                },
                                "default": "grid"
                            },
                            {
                                "ui": { "type": "field", "cols": 6 },
                                "key": "columns_desktop",
                                "type": "select",
                                "label": "Dishes Per Row (Desktop)",
                                "options": {
                                    "items": [
                                        { "title": "2 Columns", "value": "2" },
                                        { "title": "3 Columns", "value": "3" },
                                        { "title": "4 Columns", "value": "4" }
                                    ]
                                },
                                "default": "4"
                            },
                            {
                                "ui": { "type": "field", "cols": 6 },
                                "key": "limit",
                                "type": "number",
                                "label": "How Many Dishes",
                                "placeholder": "e.g. 8",
                                "default": 8
                            },
                            {
                                "ui": { "type": "field", "cols": 6 },
                                "key": "align",
                                "type": "select",
                                "label": "Heading Alignment",
                                "options": {
                                    "items": [
                                        { "title": "Left", "value": "start" },
                                        { "title": "Centre", "value": "center" }
                                    ]
                                },
                                "default": "center"
                            },
                            {
                                "ui": { "type": "field", "cols": 12 },
                                "key": "status",
                                "type": "select",
                                "label": "Status",
                                "options": {
                                    "items": [
                                        { "title": "Active", "value": "active" },
                                        { "title": "Disabled", "value": "disabled" }
                                    ]
                                },
                                "default": "active"
                            }
                        ]
                    },
                    {
                        "ui": {
                            "type": "tab",
                            "name": "Dish Card",
                            "icon": "tabler-id"
                        },
                        "name": "Dish Card",
                        "elements": [
                            {
                                "ui": { "type": "row", "cols": 12 },
                                "elements": [
                                    {
                                        "ui": { "type": "field", "cols": 6 },
                                        "key": "image_ratio",
                                        "type": "select",
                                        "label": "Image Ratio",
                                        "options": {
                                            "items": [
                                                { "title": "Inherit From Theme Settings", "value": "" },
                                                { "title": "Square (1:1)", "value": "1/1" },
                                                { "title": "Landscape (4:3)", "value": "4/3" },
                                                { "title": "Wide (16:9)", "value": "16/9" },
                                                { "title": "Portrait (3:4)", "value": "3/4" }
                                            ]
                                        },
                                        "default": ""
                                    },
                                    {
                                        "ui": { "type": "field", "cols": 6 },
                                        "key": "show_price",
                                        "type": "select",
                                        "label": "Show Price",
                                        "hint": "Theme default follows Themes → Settings → Restaurant",
                                        "options": {
                                            "items": [
                                                { "title": "Theme default", "value": "inherit" },
                                                { "title": "Show", "value": "show" },
                                                { "title": "Hide", "value": "hide" }
                                            ]
                                        },
                                        "default": "inherit"
                                    },
                                    {
                                        "ui": { "type": "field", "cols": 6 },
                                        "key": "show_tags",
                                        "type": "select",
                                        "label": "Show Tags As Badges",
                                        "options": {
                                            "items": [
                                                { "title": "Theme default", "value": "inherit" },
                                                { "title": "Show", "value": "show" },
                                                { "title": "Hide", "value": "hide" }
                                            ]
                                        },
                                        "default": "inherit"
                                    },
                                    {
                                        "ui": { "type": "field", "cols": 6 },
                                        "key": "show_description",
                                        "type": "select",
                                        "label": "Show Short Description",
                                        "options": {
                                            "items": [
                                                { "title": "Theme default", "value": "inherit" },
                                                { "title": "Show", "value": "show" },
                                                { "title": "Hide", "value": "hide" }
                                            ]
                                        },
                                        "default": "inherit"
                                    },
                                    {
                                        "ui": { "type": "field", "cols": 6 },
                                        "key": "show_add_button",
                                        "type": "switch",
                                        "label": "Show Add Button",
                                        "default": true
                                    },
                                    {
                                        "ui": { "type": "field", "cols": 6 },
                                        "key": "add_button_label",
                                        "type": "text",
                                        "label": "Add Button Label",
                                        "placeholder": "e.g. Add",
                                        "translatable": true,
                                        "default": "Add"
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "ui": {
                            "type": "tab",
                            "name": "Styling",
                            "icon": "tabler-palette"
                        },
                        "name": "Styling",
                        "elements": [
                            {
                                "ui": { "type": "row", "cols": 12 },
                                "elements": [
                                    {
                                        "ui": { "type": "field", "cols": 6 },
                                        "key": "data.style.section.id",
                                        "type": "text",
                                        "label": "Custom CSS ID",
                                        "placeholder": "e.g. popular-dishes"
                                    },
                                    {
                                        "ui": { "type": "field", "cols": 6 },
                                        "key": "data.style.section.class",
                                        "type": "text",
                                        "label": "Custom CSS Class",
                                        "placeholder": "e.g. my-dish-row"
                                    }
                                ]
                            },
                            {
                                "ui": { "type": "row", "cols": 12 },
                                "elements": [
                                    {
                                        "ui": { "type": "field", "cols": 6 },
                                        "key": "animation",
                                        "type": "select",
                                        "label": "Scroll Animation",
                                        "hint": "How this section eases into view. Theme default follows Themes → Settings → Animation; None keeps it static",
                                        "options": {
                                            "items": [
                                                { "title": "Theme default", "value": "inherit" },
                                                { "title": "None", "value": "none" },
                                                { "title": "Fade up", "value": "fade-up" },
                                                { "title": "Fade down", "value": "fade-down" },
                                                { "title": "Fade in", "value": "fade-in" },
                                                { "title": "Fade from left", "value": "fade-left" },
                                                { "title": "Fade from right", "value": "fade-right" },
                                                { "title": "Zoom in", "value": "zoom-in" },
                                                { "title": "Fade & un-blur", "value": "fade-blur" }
                                            ]
                                        },
                                        "default": "inherit"
                                    },
                                    {
                                        "ui": { "type": "field", "cols": 6 },
                                        "key": "animation_duration",
                                        "type": "select",
                                        "label": "Animation Speed",
                                        "hint": "How long each element takes to appear",
                                        "options": {
                                            "items": [
                                                { "title": "Theme default", "value": "inherit" },
                                                { "title": "Fast (0.4s)", "value": "400" },
                                                { "title": "Normal (0.7s)", "value": "700" },
                                                { "title": "Slow (1s)", "value": "1000" },
                                                { "title": "Very slow (1.4s)", "value": "1400" }
                                            ]
                                        },
                                        "default": "inherit"
                                    },
                                    {
                                        "ui": { "type": "field", "cols": 6 },
                                        "key": "animation_stagger",
                                        "type": "select",
                                        "label": "Stagger Between Items",
                                        "hint": "Gap between one item and the next when several appear together",
                                        "options": {
                                            "items": [
                                                { "title": "Theme default", "value": "inherit" },
                                                { "title": "None — all together", "value": "0" },
                                                { "title": "Subtle (60ms)", "value": "60" },
                                                { "title": "Normal (100ms)", "value": "100" },
                                                { "title": "Relaxed (160ms)", "value": "160" }
                                            ]
                                        },
                                        "default": "inherit"
                                    },
                                    {
                                        "ui": { "type": "field", "cols": 6 },
                                        "key": "animation_delay",
                                        "type": "number",
                                        "label": "Animation Delay (ms)",
                                        "placeholder": "e.g. 0",
                                        "hint": "Wait this long after the section scrolls into view before it starts",
                                        "default": 0
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    }
}
