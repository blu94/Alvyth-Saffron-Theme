{
    "type": "DISH_SHEET_SECTION",
    "component": "DishSheetSection",
    "name": "Dish Sheet",
    "description": "The configure-and-add block: size, modifier groups, special instructions, quantity and a live total.",
    "ui": {
        "icon": "tabler-tools-kitchen"
    },
    "contents": {
        "elements": [
            {
                "ui": { "type": "section", "cols": 12 },
                "name": "Layout",
                "elements": [
                    {
                        "ui": { "type": "field", "cols": 12 },
                        "key": "layout_style",
                        "type": "select",
                        "label": "Dish Layout Variant",
                        "hint": "The same eight variants core's Product Details block offers, so a dish page lays out the same way whichever of the two blocks is placed on it",
                        "options": {
                            "items": [
                                { "title": "Layout 01 - Default", "value": "default" },
                                { "title": "Layout 02 - Full Width", "value": "full_width" },
                                { "title": "Layout 03 - Grid View (Lookbook)", "value": "grid" },
                                { "title": "Layout 04 - Enhanced Slider", "value": "slider" },
                                { "title": "Layout 06 - Left Thumbnails", "value": "left_thumbs" },
                                { "title": "Layout 07 - Right Thumbnails", "value": "right_thumbs" },
                                { "title": "Layout 08 - Left Sidebar", "value": "left_sidebar" },
                                { "title": "Layout 09 - Right Sidebar", "value": "right_sidebar" }
                            ]
                        },
                        "default": "default"
                    },
                    {
                        "ui": { "type": "field", "cols": 6 },
                        "key": "sidebar_show_categories",
                        "type": "switch",
                        "label": "Sidebar: Show Courses",
                        "hint": "Layouts 08 and 09 only. The courses that hold dishes, each linking to its menu page",
                        "default": true
                    },
                    {
                        "ui": { "type": "field", "cols": 6 },
                        "key": "sidebar_show_featured",
                        "type": "switch",
                        "label": "Sidebar: Show Dish Mini-List",
                        "hint": "Layouts 08 and 09 only. The newest dishes on the menu, excluding the one being viewed",
                        "default": true
                    }
                ]
            },
            {
                "ui": { "type": "field", "cols": 12 },
                "key": "product_id",
                "type": "number",
                "label": "Dish ID",
                "placeholder": "Leave empty on a dish page",
                "hint": "Leave empty and the sheet configures whichever dish the page is for. Set an ID only to pin this block to one dish on a landing page.",
                "default": null
            },
            {
                "ui": { "type": "field", "cols": 12 },
                "key": "show_notes",
                "type": "switch",
                "label": "Allow Special Instructions",
                "hint": "A free-text note carried to the kitchen as an option value",
                "default": true
            },
            {
                "ui": { "type": "field", "cols": 12 },
                "key": "notes_label",
                "type": "text",
                "label": "Special Instructions Label",
                "placeholder": "e.g. Special instructions",
                "translatable": true,
                "default": "Special instructions"
            },
            {
                "ui": { "type": "field", "cols": 6 },
                "key": "show_categories",
                "type": "switch",
                "label": "Show Categories",
                "hint": "The courses this dish belongs to, each linking to its own menu page",
                "default": true
            },
            {
                "ui": { "type": "field", "cols": 6 },
                "key": "show_tags",
                "type": "switch",
                "label": "Show Tags",
                "hint": "The dish's labels, shown as plain chips — the same ones its card carries",
                "default": true
            }
        ]
    },
    "settings": {
        "elements": [
            {
                "ui": {
                    "type": "tabs",
                    "cols": 12,
                    "icon": "tabler-settings"
                },
                "elements": [
                    {
                        "ui": {
                            "type": "tab",
                            "name": "General",
                            "icon": "tabler-info-circle"
                        },
                        "name": "General",
                        "elements": [
                            {
                                "ui": { "type": "field", "cols": 6 },
                                "key": "max_quantity",
                                "type": "number",
                                "label": "Maximum Quantity Per Line",
                                "placeholder": "e.g. 20",
                                "default": 20
                            },
                            {
                                "ui": { "type": "field", "cols": 6 },
                                "key": "notes_max",
                                "type": "number",
                                "label": "Special Instructions Character Limit",
                                "placeholder": "e.g. 140",
                                "default": 140
                            },
                            {
                                "ui": { "type": "field", "cols": 6 },
                                "key": "size_key",
                                "type": "text",
                                "label": "Size Option Key",
                                "placeholder": "e.g. Size",
                                "hint": "The label the kitchen sees on the ticket for the chosen variant",
                                "default": "Size"
                            },
                            {
                                "ui": { "type": "field", "cols": 6 },
                                "key": "notes_key",
                                "type": "text",
                                "label": "Instructions Option Key",
                                "placeholder": "e.g. Notes",
                                "hint": "The label the kitchen sees on the ticket for the customer's note",
                                "default": "Notes"
                            },
                            {
                                "ui": { "type": "field", "cols": 12 },
                                "key": "sold_out_label",
                                "type": "text",
                                "label": "Sold Out Wording",
                                "placeholder": "e.g. Sold out for today",
                                "hint": "Leave empty to use the theme's Sold Out Wording (Themes → Settings → Restaurant), which the dish cards also use",
                                "translatable": true,
                                "default": ""
                            },
                            {
                                "ui": { "type": "field", "cols": 12 },
                                "key": "status",
                                "type": "select",
                                "label": "Status",
                                "options": {
                                    "items": [
                                        { "title": "Active", "value": "active" },
                                        { "title": "Disabled", "value": "disabled" }
                                    ]
                                },
                                "default": "active"
                            }
                        ]
                    },
                    {
                        "ui": {
                            "type": "tab",
                            "name": "Styling",
                            "icon": "tabler-palette"
                        },
                        "name": "Styling",
                        "elements": [
                            {
                                "ui": { "type": "row", "cols": 12 },
                                "elements": [
                                    {
                                        "ui": { "type": "field", "cols": 6 },
                                        "key": "data.style.section.id",
                                        "type": "text",
                                        "label": "Custom CSS ID",
                                        "placeholder": "e.g. dish-sheet"
                                    },
                                    {
                                        "ui": { "type": "field", "cols": 6 },
                                        "key": "data.style.section.class",
                                        "type": "text",
                                        "label": "Custom CSS Class",
                                        "placeholder": "e.g. my-dish-sheet"
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    }
}
