{
    "type": "OUTLET_INFO_SECTION",
    "component": "OutletInfoSection",
    "name": "Outlet Info",
    "description": "Address, phone and the week's opening hours, read from the theme's service windows.",
    "ui": {
        "icon": "tabler-map-pin"
    },
    "contents": {
        "elements": [
            {
                "ui": { "type": "field", "cols": 12 },
                "key": "heading",
                "type": "text",
                "label": "Heading",
                "placeholder": "e.g. Find us",
                "translatable": true,
                "default": "Find us"
            },
            {
                "ui": { "type": "field", "cols": 12 },
                "key": "address",
                "type": "textarea",
                "label": "Address",
                "placeholder": "Leave empty to use the footer address",
                "hint": "Falls back to Theme Settings → Footer → Outlet Address",
                "translatable": true,
                "default": ""
            },
            {
                "ui": { "type": "field", "cols": 6 },
                "key": "phone",
                "type": "text",
                "label": "Phone",
                "placeholder": "Leave empty to use the footer phone",
                "default": ""
            },
            {
                "ui": { "type": "field", "cols": 6 },
                "key": "email",
                "type": "text",
                "label": "Email",
                "placeholder": "e.g. hello@example.com",
                "default": ""
            },
            {
                "ui": { "type": "field", "cols": 12 },
                "key": "map_url",
                "type": "link",
                "label": "Directions Link",
                "default": { "url": "", "type": "external", "target": "_blank" }
            },
            {
                "ui": { "type": "field", "cols": 12 },
                "key": "note",
                "type": "textarea",
                "label": "Note",
                "placeholder": "e.g. Parking behind the building. Pickup at the side counter.",
                "translatable": true,
                "default": ""
            }
        ]
    },
    "settings": {
        "elements": [
            {
                "ui": { "type": "tabs", "cols": 12, "icon": "tabler-settings" },
                "elements": [
                    {
                        "ui": { "type": "tab", "name": "General", "icon": "tabler-info-circle" },
                        "name": "General",
                        "elements": [
                            {
                                "ui": { "type": "field", "cols": 6 },
                                "key": "show_hours",
                                "type": "switch",
                                "label": "Show Opening Hours",
                                "hint": "Read live from Service Windows. Nothing renders until at least one window is authored",
                                "default": true
                            },
                            {
                                "ui": { "type": "field", "cols": 6 },
                                "key": "status",
                                "type": "select",
                                "label": "Status",
                                "options": {
                                    "items": [
                                        { "title": "Active", "value": "active" },
                                        { "title": "Disabled", "value": "disabled" }
                                    ]
                                },
                                "default": "active"
                            }
                        ]
                    },
                    {
                        "ui": { "type": "tab", "name": "Styling", "icon": "tabler-palette" },
                        "name": "Styling",
                        "elements": [
                            {
                                "ui": { "type": "row", "cols": 12 },
                                "elements": [
                                    {
                                        "ui": { "type": "field", "cols": 6 },
                                        "key": "data.style.section.id",
                                        "type": "text",
                                        "label": "Custom CSS ID",
                                        "placeholder": "e.g. outlet"
                                    },
                                    {
                                        "ui": { "type": "field", "cols": 6 },
                                        "key": "data.style.section.class",
                                        "type": "text",
                                        "label": "Custom CSS Class",
                                        "placeholder": "e.g. my-outlet"
                                    }
                                ]
                            },
                            {
                                "ui": { "type": "row", "cols": 12 },
                                "elements": [
                                    {
                                        "ui": { "type": "field", "cols": 6 },
                                        "key": "animation",
                                        "type": "select",
                                        "label": "Scroll Animation",
                                        "hint": "How this section eases into view. Theme default follows Themes → Settings → Animation; None keeps it static",
                                        "options": {
                                            "items": [
                                                { "title": "Theme default", "value": "inherit" },
                                                { "title": "None", "value": "none" },
                                                { "title": "Fade up", "value": "fade-up" },
                                                { "title": "Fade down", "value": "fade-down" },
                                                { "title": "Fade in", "value": "fade-in" },
                                                { "title": "Fade from left", "value": "fade-left" },
                                                { "title": "Fade from right", "value": "fade-right" },
                                                { "title": "Zoom in", "value": "zoom-in" },
                                                { "title": "Fade & un-blur", "value": "fade-blur" }
                                            ]
                                        },
                                        "default": "inherit"
                                    },
                                    {
                                        "ui": { "type": "field", "cols": 6 },
                                        "key": "animation_duration",
                                        "type": "select",
                                        "label": "Animation Speed",
                                        "hint": "How long each element takes to appear",
                                        "options": {
                                            "items": [
                                                { "title": "Theme default", "value": "inherit" },
                                                { "title": "Fast (0.4s)", "value": "400" },
                                                { "title": "Normal (0.7s)", "value": "700" },
                                                { "title": "Slow (1s)", "value": "1000" },
                                                { "title": "Very slow (1.4s)", "value": "1400" }
                                            ]
                                        },
                                        "default": "inherit"
                                    },
                                    {
                                        "ui": { "type": "field", "cols": 6 },
                                        "key": "animation_stagger",
                                        "type": "select",
                                        "label": "Stagger Between Items",
                                        "hint": "Gap between one item and the next when several appear together",
                                        "options": {
                                            "items": [
                                                { "title": "Theme default", "value": "inherit" },
                                                { "title": "None — all together", "value": "0" },
                                                { "title": "Subtle (60ms)", "value": "60" },
                                                { "title": "Normal (100ms)", "value": "100" },
                                                { "title": "Relaxed (160ms)", "value": "160" }
                                            ]
                                        },
                                        "default": "inherit"
                                    },
                                    {
                                        "ui": { "type": "field", "cols": 6 },
                                        "key": "animation_delay",
                                        "type": "number",
                                        "label": "Animation Delay (ms)",
                                        "placeholder": "e.g. 0",
                                        "hint": "Wait this long after the section scrolls into view before it starts",
                                        "default": 0
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    }
}
