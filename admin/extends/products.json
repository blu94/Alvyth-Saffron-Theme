{
  "extends": "products",
  "owns": ["modifier_groups", "exclusive_outlet_ids"],
  "handler": "Theme\\Backend\\Handlers\\ProductContributions",
  "tabs": [
    {
      "name": "Availability",
      "ui": {
        "type": "tab",
        "icon": "tabler-building-store"
      },
      "elements": [
        {
          "ui": {
            "type": "section",
            "cols": 12,
            "icon": "tabler-building-store"
          },
          "name": "Where This Dish Is Available",
          "subtitle": "Leave this empty and the dish is on the menu at every branch, which is what almost every dish wants. Name branches only to make it exclusive to them — a regional special, a dish only one kitchen has the equipment for. It is stated once, here, and stays true as you open more branches. It covers the whole dish, every size and variant with it.",
          "elements": [
            {
              "ui": {
                "type": "field",
                "cols": 12,
                "multiple": true,
                "chips": true,
                "closableChips": true,
                "clearable": true,
                "autoSelectSingle": false
              },
              "key": "exclusive_outlet_ids",
              "type": "autocomplete",
              "label": "Exclusive To Branches",
              "placeholder": "Every branch",
              "hint": "Empty means every branch serves it. Name one branch and only that branch shows it; name two and it shows at those two and nowhere else. Setting this on a dish nobody else sells is how you say 'KLCC only' — you never have to touch the other branches. Set it on the dish itself: the whole dish moves together, so you cannot offer Large at one branch and Regular at another, and this tab reads the same on every variant's own form",
              "options": {
                "url": "/admin/modules/outlets/options",
                "master": "outlets"
              },
              "rules": ["nullable", "array"]
            }
          ]
        }
      ]
    },
    {
      "name": "Modifiers",
      "ui": {
        "type": "tab",
        "icon": "tabler-adjustments-alt"
      },
      "elements": [
        {
          "ui": {
            "type": "section",
            "cols": 12,
            "icon": "tabler-adjustments-alt"
          },
          "name": "Questions Asked About This Dish",
          "subtitle": "Groups are authored once under Modifier Groups and attached here. The dish sheet asks them in the order below.",
          "elements": [
            {
              "ui": { "type": "field", "cols": 12 },
              "key": "modifier_groups",
              "type": "repeater",
              "label": "Modifier Groups",
              "itemLabel": "Group",
              "columns": [
                { "label": "Group", "key": "modifier_group_id" },
                { "label": "Required", "key": "required_override" }
              ],
              "dialog": {
                "width": 620,
                "create": {
                  "title": "Attach A Group",
                  "subtitle": "Pick a question this dish should ask. Attach the parent dish and every variant inherits it."
                },
                "update": { "title": "Edit Attachment" }
              },
              "elements": [
                {
                  "ui": { "type": "field", "cols": 12 },
                  "key": "modifier_group_id",
                  "type": "autocomplete",
                  "label": "Group",
                  "placeholder": "Search modifier groups",
                  "options": {
                    "url": "/admin/modules/modifier-groups",
                    "master": "data",
                    "map": { "title": "title.en", "value": "id" }
                  },
                  "rules": ["required", "integer", "exists:modifier_groups,id"]
                },
                {
                  "ui": { "type": "field", "cols": 12 },
                  "key": "required_override",
                  "type": "select",
                  "label": "Required",
                  "hint": "Inherit uses the group's own minimum selection. Override only where this dish differs.",
                  "default": "",
                  "options": [
                    { "label": "Inherit from group", "value": "" },
                    { "label": "Required", "value": "1" },
                    { "label": "Optional", "value": "0" }
                  ],
                  "rules": ["nullable"]
                }
              ],
              "rules": ["nullable", "array"]
            }
          ]
        }
      ]
    }
  ]
}
